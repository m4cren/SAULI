SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SAULI_ADMIN_USER_ID=<admin-auth-user-uuid>
SUPABASE_STORAGE_BUCKET=sauli-item-images
SUPABASE_SIGNED_URL_TTL_SECONDS=900
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q8_0
OLLAMA_TIMEOUT_SECONDS=180
FRONTEND_ORIGIN=http://localhost:3000
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
RETRIEVAL_QR_TTL_MINUTES=180
RETRIEVAL_TOKEN_PEPPER=<long-random-server-only-secret-at-least-32-characters>
ENVIRONMENT=development
# Configure these after creating the EmailJS service and template. Never use NEXT_PUBLIC_* for keys.
EMAILJS_ENABLED=false
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional. Leave empty if the EmailJS account does not require a private key.
EMAILJS_PRIVATE_KEY=
EMAILJS_TIMEOUT_SECONDS=10
EMAILJS_MAX_RETRIES=3
FRONTEND_BASE_URL=http://localhost:3000
MATCH_NOTIFICATION_MIN_SCORE=65

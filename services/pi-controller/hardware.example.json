{
  "mode": "simulation",
  "device_id": "REPLACE-WITH-REGISTERED-DEVICE-UUID",
  "reed_closed_level": {"medium": 0, "pocket": 0},
  "output_active_high": {
    "main_light": true, "buzzer": true,
    "medium_solenoid": true, "pocket_solenoid": true,
    "pocket_light_gate": true, "medium_light_gate": true

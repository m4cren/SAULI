{
  "mode": "simulation",
  "sensor_simulation_enabled": false,
  "hx711_change_threshold_g": 5.0,
  "hx711_restore_threshold_g": 2.0,
  "hx711_stable_telemetry_samples": 2,
  "hx711_slot_thresholds_g": {},
  "device_id": "REPLACE-WITH-REGISTERED-DEVICE-UUID",
  "command_transport": "direct",
  "direct_api_token": "REPLACE-WITH-THE-SAME-32-PLUS-CHARACTER-API-TOKEN",
  "direct_bind_host": "127.0.0.1",
  "direct_port": 8765,
  "direct_replay_file": "/var/lib/sauli/hardware-command-replay.json",
  "direct_incident_queue_file": "/var/lib/sauli/hardware-incident-queue.json",
  "direct_completion_queue_file": "/var/lib/sauli/hardware-completion-queue.json",
  "reed_closed_level": {"medium": 0, "pocket": 0},
  "output_active_high": {
    "main_light": true, "buzzer": true,
    "medium_solenoid": true, "pocket_solenoid": true
  },
  "solenoid_max_hold_seconds": 300,
  "gpio_sample_seconds": 0.05,
  "telemetry_interval_seconds": 0.5,
  "telemetry_min_gap_seconds": 0.15,
  "door_open_timeout_seconds": 60,
  "door_open_timeout_policy": "continue_waiting",
  "door_close_timeout_seconds": 120,
  "door_close_timeout_policy": "continue_waiting",
  "capture_light_max_seconds": 12,
  "enable_actuators": false,
  "output_polarity_verified": false,
  "solenoid_led_test_channel": null,
  "esp_port": "/dev/serial0",
  "esp_baud": 115200
}

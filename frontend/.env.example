NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side Next.js calls from Vercel must reach FastAPI over HTTPS.
SAULI_API_INTERNAL_URL=http://localhost:8000
SAULI_ADMIN_USER_ID=<admin-auth-user-uuid>

# Show operator sensor simulation controls in the deployed kiosk (default false).
# The operator token is entered at runtime and must NEVER be exposed as NEXT_PUBLIC.
NEXT_PUBLIC_SENSOR_SIMULATION_ENABLED=false
